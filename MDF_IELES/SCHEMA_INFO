        {
            ""view"": ""battery_stock_summary"",
            ""definition"": "" SELECT 'charging'::text AS kind,\n    charging_jobs.status,\n    count(*)::integer AS count\n   FROM charging_jobs\n  WHERE charging_jobs.status = 'in_shop'::text\n  GROUP BY charging_jobs.status\nUNION ALL\n SELECT 'claim'::text AS kind,\n    battery_claims.status,\n    count(*)::integer AS count\n   FROM battery_claims\n  WHERE battery_claims.status = ANY (ARRAY['received'::text, 'sent_to_distributor'::text, 'approved'::text])\n  GROUP BY battery_claims.status;""
        },
        {
            ""view"": ""battery_claims_by_distributor"",
            ""definition"": "" SELECT d.id AS distributor_id,\n    d.name AS distributor_name,\n    c.status,\n    count(*)::integer AS count\n   FROM battery_claims c\n     JOIN distributors d ON d.id = c.distributor_id\n  WHERE c.status = ANY (ARRAY['sent_to_distributor'::text, 'approved'::text])\n  GROUP BY d.id, d.name, c.status;""
        },
